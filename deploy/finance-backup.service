[Unit]
Description=Personal finance online SQLite backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=financeapp
Group=financeapp
WorkingDirectory=/opt/personal-finance/current
EnvironmentFile=/etc/personal-finance/finance.env
ExecStart=/opt/personal-finance/current/.venv/bin/finance backup --directory /var/lib/personal-finance/backups --keep 14
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/personal-finance/data
ReadWritePaths=/var/lib/personal-finance/backups
MemoryMax=300M
UMask=0077
